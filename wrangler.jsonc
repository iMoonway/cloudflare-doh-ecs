{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-doh-ecs",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "RULES_KV","id": "11c9a27ea0fd4363abd85b60d249bb83"
    }
  ],
  "vars": {
    "DOH_PATH": "/Vq2DJQaMIlavyWv9tsmpx95fBXYBeOri/doh",
    "DOMESTIC_DOH_URL": "https://dns.adguard.com/dns-query",
    "DOMESTIC_FALLBACK_DOH_URL": "https://dns.alidns.com/dns-query",
    "GLOBAL_DOH_URL": "https://dns.adguard.com/dns-query",
    "GLOBAL_FALLBACK_DOH_URL": "https://dns.google/dns-query"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
